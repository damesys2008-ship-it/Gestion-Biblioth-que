            "url": {
              "raw": "{{baseUrl}}/emprunts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "emprunts"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Code HTTP attendu : 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Emprunt créé avec les champs attendus sans email', function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(4);",
                  "    pm.expect(body.rendu).to.eql(false);",
                  "    pm.expect(body.enRetard).to.eql(false);",
                  "    pm.expect(body).not.to.have.property('emailEmprunteur');",
                  "});"
                ]
              }
            }
          ]
        },
